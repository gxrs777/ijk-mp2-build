name: build-media3-ffmpeg-aar

on:
  workflow_dispatch:
  push:
    tags:
      - 'ffmpeg-*'

env:
  MEDIA3_TAG: 1.11.1
  NDK_VERSION: 25.2.9519653
  TARGET_ABIS: "arm64-v8a,armeabi-v7a"   # 需要 x86/x86_64 可加

jobs:
  build:
    runs-on: ubuntu-24.04

    steps:
      - name: Checkout Media3 (tag)
        uses: actions/checkout@v4
        with:
          repository: androidx/media
          ref: ${{ env.MEDIA3_TAG }}
          fetch-depth: 1

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Setup Android SDK
        uses: android-actions/setup-android@v3

      - name: Accept Android licenses
        run: yes | sdkmanager --licenses || true

      - name: Install NDK
        run: sdkmanager --install "ndk;${{ env.NDK_VERSION }}"

      - name: Configure FFmpeg decoders / parsers / demuxer
        run: |
          JNI_DIR="libraries/decoder_ffmpeg/src/main/jni"
          COMMAND_FILE="$JNI_DIR/ffmpeg_command.txt"
          # 追加需要的功能参数（FFmpeg configure 允许多次 --enable-*）
          cat >> "$COMMAND_FILE" <<'EOF'
          --enable-decoder=aac,aac_latm,mp2,mp3,ac3,eac3,flac,opus,pcm_s16le,pcm_alaw,pcm_mulaw
          --enable-parser=aac,ac3,mpegaudio
          --enable-demuxer=mpegts
          --enable-protocol=file,tcp,udp,rtp,http,https
          EOF

      - name: Build media3-decoder-ffmpeg AAR
        env:
          ANDROID_NDK_HOME: ${{ env.ANDROID_HOME }}/ndk/${{ env.NDK_VERSION }}
        run: |
          chmod +x gradlew
          ./gradlew :media3-decoder-ffmpeg:assembleRelease \
            -Pandroid.injected.build.abi=${{ env.TARGET_ABIS }} \
            --no-daemon

      - name: Upload AAR
        uses: actions/upload-artifact@v4
        with:
          name: media3-ffmpeg-aar
          path: libraries/decoder_ffmpeg/build/outputs/aar/media3-decoder-ffmpeg-release.aar
